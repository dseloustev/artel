diff --git a/src/domain/memory_session_store.ts b/src/domain/memory_session_store.ts
--- /dev/null
+++ b/src/domain/memory_session_store.ts
@@ -0,0 +1,28 @@
+import { Session, SessionNotFound, SessionStore } from './session';
+
+export class MemorySessionStore implements SessionStore {
+  private readonly sessions = new Map<string, Session>();
+
+  async get(id: string): Promise<Session> {
+    const session = this.sessions.get(id);
+    if (!session) {
+      throw new SessionNotFound(id);
+    }
+    return session;
+  }
+
+  async put(session: Session): Promise<void> {
+    this.sessions.set(session.id, session);
+  }
+
+  async touch(id: string, now = Date.now()): Promise<Session> {
+    const session = await this.get(id);
+    const touched = { ...session, lastSeenAt: now };
+    await this.put(touched);
+    return touched;
+  }
+
+  async delete(id: string): Promise<boolean> {
+    return this.sessions.delete(id);
+  }
+}
