#!/usr/bin/env python3
"""Offline `gh` for the collaborative-review evaluation fixtures (evaluation-only).

This file is never shipped and never part of the plugin build. Copy it into a
sandbox as `<sandbox>/bin/gh`, put `<sandbox>/bin` first on PATH, and keep the
active canned responses in `<sandbox>/github/`:

    github/pr-view.json        `gh pr view --json ...` output
    github/pages.json          slurped `.../pulls/<n>/files` pages (array of arrays)
    github/compare.json        `.../compare/<base>...<head>` with merge_base_commit.sha
    github/pr-diff.patch       `gh pr diff` output
    github/contents/base/<p>   full content at the merge base (or the base tip)
    github/contents/head/<p>   full content at the head revision

It answers the commands the workflow pins and refuses everything else; it makes
no network calls and writes nothing. Flags it does not model (`--jq`, ...) are
ignored and the raw JSON is printed instead.
"""
import base64
import json
import posixpath
import sys
from pathlib import Path
from urllib.parse import unquote

SANDBOX = Path(__file__).resolve().parent.parent
DATA = SANDBOX / 'github'


def emit(text):
    sys.stdout.write(text if text.endswith('\n') else text + '\n')


def fail(message):
    print(json.dumps({'message': message,
                      'documentation_url': 'https://docs.github.com/rest'}), file=sys.stderr)
    return 1


def load(name):
    path = DATA / name
    return json.loads(path.read_text(encoding='utf-8')) if path.is_file() else None


def pr_view(argv):
    meta = load('pr-view.json')
    if meta is None:
        return fail('Not Found')
    if '--json' in argv:
        fields = argv[argv.index('--json') + 1].split(',')
        emit(json.dumps({key: meta[key] for key in fields if key in meta}, indent=2))
        return 0
    emit('\n'.join(['title:\t' + meta['title'], 'state:\tOPEN', 'url:\t' + meta['url'],
                    'base:\t' + meta['baseRefOid'], 'head:\t' + meta['headRefOid']]))
    return 0


def pr_diff(argv):
    diff = DATA / 'pr-diff.patch'
    if not diff.is_file():
        return fail('Not Found')
    sys.stdout.write(diff.read_text(encoding='utf-8'))
    return 0


def api(argv):
    endpoint = next((arg for arg in argv if arg.startswith(('repos/', 'http'))), None)
    if endpoint is None:
        return fail('Not Found')
    if endpoint.startswith('http'):
        endpoint = endpoint.split('/repos/', 1)[-1]
        endpoint = 'repos/' + endpoint.lstrip('/')
    query = endpoint.split('?', 1)[1] if '?' in endpoint else ''
    parts = [unquote(part) for part in endpoint.split('?', 1)[0].strip('/').split('/')]
    if len(parts) < 5 or parts[0] != 'repos':
        return fail('Not Found')
    kind = parts[3]

    if kind == 'pulls' and len(parts) == 6 and parts[5] == 'files':
        pages = load('pages.json')
        if pages is None:
            return fail('Not Found')
        if '--slurp' in argv:
            emit(json.dumps(pages, indent=2))
        elif '--paginate' in argv:
            for page in pages:
                emit(json.dumps(page, indent=2))
        else:
            emit(json.dumps(pages[0], indent=2))
        return 0

    if kind == 'compare' and len(parts) == 5:
        meta = load('pr-view.json') or {}
        refs = sorted(parts[4].split('...'))
        if refs != sorted([meta.get('baseRefOid'), meta.get('headRefOid')]):
            return fail('Not Found')
        compare = load('compare.json')
        if compare is None:
            return fail('Not Found')
        emit(json.dumps(compare, indent=2))
        return 0

    if kind == 'contents' and len(parts) >= 5:
        path = '/'.join(parts[4:])
        ref = None
        for key in query.split('&'):
            if key.startswith('ref='):
                ref = unquote(key[len('ref='):])
        for index, arg in enumerate(argv):
            if arg in ('-f', '-F', '--field', '--raw-field') and index + 1 < len(argv) \
                    and argv[index + 1].startswith('ref='):
                ref = argv[index + 1].split('=', 1)[1]
        meta = load('pr-view.json') or {}
        compare = load('compare.json') or {}
        merge = (compare.get('merge_base_commit') or {}).get('sha')
        side = ('head' if ref == meta.get('headRefOid')
                else 'base' if ref in (meta.get('baseRefOid'), merge) else None)
        if side is None:
            return fail('Not Found')
        content = DATA / 'contents' / side / path
        if not content.is_file():
            return fail('Not Found')
        data = content.read_bytes()
        if any('application/vnd.github.raw' in arg for arg in argv):
            sys.stdout.write(data.decode('utf-8'))
            return 0
        emit(json.dumps({
            'type': 'file',
            'encoding': 'base64',
            'size': len(data),
            'name': posixpath.basename(path),
            'path': path,
            'content': base64.b64encode(data).decode('ascii'),
        }, indent=2))
        return 0

    return fail('Not Found')


def main():
    argv = sys.argv[1:]
    if not argv:
        print('gh: the offline fixture shim needs a command', file=sys.stderr)
        return 2
    if argv[0] == '--version':
        emit('gh version 2.62.0 (offline fixture shim)')
        return 0
    if argv[0] == 'auth' and len(argv) > 1 and argv[1] == 'status':
        print('github.com\n  ✓ Logged in to github.com as fixture-user (offline fixture)',
              file=sys.stderr)
        return 0
    if argv[0] == 'pr' and len(argv) > 1 and argv[1] == 'view':
        return pr_view(argv[2:])
    if argv[0] == 'pr' and len(argv) > 1 and argv[1] == 'diff':
        return pr_diff(argv[2:])
    if argv[0] == 'api':
        return api(argv[1:])
    print('gh: the offline fixture shim does not implement: ' + ' '.join(argv), file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
